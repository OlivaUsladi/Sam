# Database
DB_PASSWORD=your_secure_db_password_here

# JWT
JWT_SECRET=your_random_64_char_secret_here

# Email encryption keys (for GDPR-compliant email storage)
EMAIL_HMAC_KEY=your_random_32_char_key_here
EMAIL_AES_KEY=your_random_32_char_key_here

# SMTP (Yandex 360 / any SMTP provider)
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=noreply@sam-app.ru
MAIL_PASSWORD=your_yandex_app_password_here
MAIL_FROM=noreply@sam-app.ru
MAIL_SUPPORT=support@sam-app.ru

# Frontend base URL (for password reset links)
FRONTEND_BASE_URL=https://sam-app.ru
