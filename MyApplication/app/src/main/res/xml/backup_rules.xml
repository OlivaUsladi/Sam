<?xml version="1.0" encoding="utf-8"?>
<!-- Android < 12. Флаг "onboarding пройден" и токены не должны переезжать
     из облачного бэкапа в новую установку. -->
<full-backup-content>
    <exclude domain="sharedpref" path="sam_onboarding.xml"/>
    <exclude domain="sharedpref" path="sam_secure_auth.xml"/>
</full-backup-content>
